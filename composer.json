{
    "name": "jovian/venusian-metal",
    "description": "The 'metal' rendering engine for Venusian Surface: a GpuDevice over ext-metal that draws Surface's draw lists on the Mac's GPU and presents into a CAMetalLayer.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "metal",
        "macos"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-metal/0.10.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-metal/issues",
        "source": "https://github.com/jovian-packages/venusian-metal"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-metal": "^0.10",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/drawing": "^0.10.0",
        "venusian-surface/framebuffers": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-surface/fonts": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\Metal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\Metal\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\Metal\\Providers\\VenusianMetalServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
