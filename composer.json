{
    "name": "jovian/venusian-metal",
    "description": "The 'metal' graphics engine for Venusian Topside: framebuffers and a rasterizer on the Mac's GPU, through ext-metal.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "metal",
        "macos"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-metal/0.11.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-metal/issues",
        "source": "https://github.com/jovian-packages/venusian-metal"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "ext-appkit": "^0.11.2",
        "ext-metal": "^0.11.0",
        "venusian/topside": "^0.11.5"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\Metal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\Metal\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\Metal\\Providers\\VenusianMetalServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
